# Production settings for deploy/docker-compose.prod.yml.
# Copy to deploy/.env on the server (it is git-ignored) and fill in every value.
# Generate secrets on the server, for example: openssl rand -hex 32

# Public hostname that points to the VM's public IP, e.g. mascot-dat.duckdns.org
DOMAIN=

# PostgreSQL (internal only). Use letters and digits in the password: it is
# embedded in DATABASE_URL, so URL-special characters would break it.
POSTGRES_DB=mascot
POSTGRES_USER=mascot
POSTGRES_PASSWORD=

# Auth
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI provider
AI_PROVIDER=groq
GROQ_API_KEY=
# OPENAI_API_KEY=

# Password-reset email: console, gmail_smtp, resend or brevo
EMAIL_PROVIDER=console
EMAIL_FROM=Mascot <onboarding@resend.dev>
# BREVO_API_KEY=
# RESEND_API_KEY=
# SMTP_USERNAME=
# SMTP_APP_PASSWORD=
