# Environment: development, test, staging, or production (disables /docs and /openapi.json in production)
ENVIRONMENT=development
# Database connection: local PostgreSQL or remote (e.g. Neon PostgreSQL)
DATABASE_URL=postgresql+psycopg://mascot:change-me-local-only@localhost:5432/mascot
# CORS origins: JSON array or comma-separated URLs (e.g. ["http://localhost:5173"] or ["https://mascot.vercel.app"])
CORS_ORIGINS=["http://localhost:5173"]
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=mascot-api
JWT_AUDIENCE=mascot-frontend
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_MAX_TOOL_ROUNDS=5
AI_MAX_TOOL_CALLS_PER_ROUND=4
AI_MAX_TOTAL_TOOL_CALLS=8
AI_TOOL_MAX_ARGUMENT_BYTES=8192
AI_TOOL_MAX_PAYLOAD_BYTES=65536
AI_TOOL_TIMEOUT_SECONDS=5
AI_ACTION_TOKEN_EXPIRE_SECONDS=300
AI_ACTION_TOKEN_AUDIENCE=mascot-ai-action
# Optional fallback: set AI_PROVIDER=openai to use these values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
AI_REQUEST_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=800
AI_EXERCISE_MAX_OUTPUT_TOKENS=4000
# Email & Password Reset
# EMAIL_PROVIDER options: console (local dev/logs), brevo (production/real delivery
# over HTTPS, works where SMTP ports are blocked), resend, gmail_smtp, or test
EMAIL_PROVIDER=console
# Gmail SMTP (for EMAIL_PROVIDER=gmail_smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_APP_PASSWORD=
# Resend (for EMAIL_PROVIDER=resend) - needs a verified sending domain
RESEND_API_KEY=
# Brevo (for EMAIL_PROVIDER=brevo) - verifies a single sender address by email,
# so no domain is required
BREVO_API_KEY=
# Common email settings
EMAIL_FROM=Mascot <your-email@gmail.com>
FRONTEND_BASE_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=20


